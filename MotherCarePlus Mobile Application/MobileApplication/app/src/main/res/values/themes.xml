<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- MotherCare+ Application Theme -->
    <style name="Theme.MotherCare" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colour -->
        <item name="colorPrimary">@color/mothercare_purple</item>
        <item name="colorPrimaryVariant">@color/mothercare_purple_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary colour -->
        <item name="colorSecondary">@color/mothercare_purple_light</item>
        <item name="colorSecondaryVariant">@color/mothercare_purple</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <!-- Surfaces -->
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface_bg</item>
        <!-- Status bar colour matches background so it blends seamlessly -->
        <item name="android:statusBarColor">#FAF6FC</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Remove default action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Material text input accent -->
        <item name="colorControlActivated">@color/mothercare_purple</item>
        <item name="colorControlHighlight">@color/button_ripple</item>
    </style>

    <!-- Splash / Get Started screen -->
    <style name="Theme.MotherCare.GetStarted" parent="Theme.MotherCare">
        <item name="android:statusBarColor">#FBF7FC</item>
    </style>

    <!-- Date Picker dialog styled with brand purple -->
    <style name="DatePickerTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">#985AB5</item>
        <item name="colorAccent">#985AB5</item>
        <item name="android:textColorPrimary">#3D3045</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

</resources>