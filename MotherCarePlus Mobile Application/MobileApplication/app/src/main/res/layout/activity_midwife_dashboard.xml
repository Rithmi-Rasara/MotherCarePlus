<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF6FC"
    android:fitsSystemWindows="true">

    <!-- TOP HEADER (CLEAN TOP PADDING, NO CLIPPING) -->
    <RelativeLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAF6FC"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/headerTextContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnMidwifeNotification"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome, Public Health Midwife 👋"
                android:textColor="#756A7D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtMidwifeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Midwife"
                android:textColor="#3D3045"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtClinicAreaHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="MOH Clinic • Area Care Unit 🏥"
                android:textColor="#2980B9"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnMidwifeNotification"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@+id/headerTextContainer"
            android:background="@drawable/circle_background"
            android:contentDescription="Notifications"
            android:padding="11dp"
            android:src="@drawable/ic_notifications"
            android:tint="#985AB5" />

    </RelativeLayout>


    <!-- SCROLLABLE MIDDLE CONTENT -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">


            <!-- MIDWIFE INFO & CLINIC BANNER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/midwife_card_background"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Midwife Portal Dashboard"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtClinicArea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Assigned MOH Clinic Area"
                            android:textColor="#D6EAF8"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Midwife"
                        android:src="@drawable/ic_health"
                        android:tint="#FFFFFF" />

                </LinearLayout>

                <!-- DATE ROW -->
                <TextView
                    android:id="@+id/txtTodayDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Today's Schedule"
                    android:textColor="#D6EAF8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtDateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Loading..."
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- TODAY'S OVERVIEW STATS GRID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:text="Maternal Healthcare Overview"
                android:textColor="#3D3045"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <!-- TOTAL PATIENTS -->
                <LinearLayout
                    android:id="@+id/statTotalPatients"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/midwife_stat_background"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Patients"
                        android:src="@drawable/ic_person"
                        android:tint="#985AB5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Registered Mothers"
                        android:textColor="#756A7D"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtTotalPatients"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="1,256"
                        android:textColor="#3D3045"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- TODAY VISITS -->
                <LinearLayout
                    android:id="@+id/statTodayVisits"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/midwife_stat_background"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Visits"
                        android:src="@drawable/ic_calendar"
                        android:tint="#985AB5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Today Visits"
                        android:textColor="#756A7D"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtTodayVisits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="5"
                        android:textColor="#3D3045"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- HIGH RISK -->
                <LinearLayout
                    android:id="@+id/statHighRisk"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/midwife_stat_background"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="High risk"
                        android:src="@drawable/ic_heart"
                        android:tint="#E74C3C" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="High Risk Mothers"
                        android:textColor="#756A7D"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtHighRisk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="3"
                        android:textColor="#E74C3C"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- QUICK ACTIONS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:text="Quick Actions"
                android:textColor="#3D3045"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- QUICK ACTIONS ROW 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal">

                <!-- REGISTER MOTHER -->
                <LinearLayout
                    android:id="@+id/btnAddPatient"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/midwife_action_background"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Register Mother"
                        android:src="@drawable/ic_person"
                        android:tint="#985AB5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Register Mother"
                        android:textColor="#3D3045"
                        android:textSize="11sp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- SCHEDULE VISIT -->
                <LinearLayout
                    android:id="@+id/btnScheduleVisit"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/midwife_action_background"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Schedule Visit"
                        android:src="@drawable/ic_calendar"
                        android:tint="#985AB5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Schedule Visit"
                        android:textColor="#3D3045"
                        android:textSize="11sp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- HEALTH RECORDS -->
                <LinearLayout
                    android:id="@+id/btnHealthRecords"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/midwife_action_background"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Health Records"
                        android:src="@drawable/ic_report"
                        android:tint="#985AB5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Update Records"
                        android:textColor="#3D3045"
                        android:textSize="11sp"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>


            <!-- UPCOMING VISITS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Assigned Home Visits"
                    android:textColor="#3D3045"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textColor="#985AB5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- VISIT CARD 1 -->
            <LinearLayout
                android:id="@+id/visitCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/white_card_background"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/midwife_stat_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Patient"
                        android:src="@drawable/ic_pregnancy"
                        android:tint="#2E86C1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtVisit1Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kamala Perera"
                        android:textColor="#3D3045"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVisit1Detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="28 Weeks • 09:00 AM"
                        android:textColor="#756A7D"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtVisit1Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/midwife_stat_background"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Scheduled"
                    android:textColor="#985AB5"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- VISIT CARD 2 -->
            <LinearLayout
                android:id="@+id/visitCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/white_card_background"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/midwife_stat_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Patient"
                        android:src="@drawable/ic_pregnancy"
                        android:tint="#2E86C1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtVisit2Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nilmini Silva"
                        android:textColor="#3D3045"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVisit2Detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="34 Weeks • 11:30 AM"
                        android:textColor="#756A7D"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtVisit2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/midwife_stat_background"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Scheduled"
                    android:textColor="#985AB5"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- VISIT CARD 3 (HIGH RISK ALERT) -->
            <LinearLayout
                android:id="@+id/visitCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/white_card_background"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/midwife_stat_background"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Patient"
                        android:src="@drawable/ic_pregnancy"
                        android:tint="#E74C3C" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtVisit3Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Priya Fernando"
                        android:textColor="#3D3045"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVisit3Detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="38 Weeks • 02:00 PM ⚠ High Risk"
                        android:textColor="#E74C3C"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtVisit3Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/emergency_background"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="High Risk"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- VACCINATION DUE TRACKER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:text="Vaccination &amp; Clinic Tracker"
                android:textColor="#3D3045"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/vaccineCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/white_card_background"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/midwife_stat_background"
                    android:contentDescription="Vaccine"
                    android:padding="10dp"
                    android:src="@drawable/ic_vaccine"
                    android:tint="#985AB5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtVaccineName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tetanus Toxoid (TT) Dose 2"
                        android:textColor="#3D3045"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVaccineCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="3 assigned mothers due this week"
                        android:textColor="#756A7D"
                        android:textSize="13sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Open"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#985AB5" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- FIXED BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_home"
                android:tint="#985AB5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="#985AB5"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- PATIENTS -->
        <LinearLayout
            android:id="@+id/navPatients"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Patients"
                android:src="@drawable/ic_person"
                android:tint="#8E8294" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Mothers"
                android:textColor="#8E8294"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- VISITS -->
        <LinearLayout
            android:id="@+id/navVisits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Visits"
                android:src="@drawable/ic_calendar"
                android:tint="#8E8294" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Visits"
                android:textColor="#8E8294"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Profile"
                android:src="@drawable/ic_health"
                android:tint="#8E8294" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profile"
                android:textColor="#8E8294"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>