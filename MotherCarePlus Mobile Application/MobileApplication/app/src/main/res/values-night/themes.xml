<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- MotherCare+ Night Theme (force light for medical clarity) -->
    <style name="Theme.MotherCare" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/mothercare_purple</item>
        <item name="colorPrimaryVariant">@color/mothercare_purple_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/mothercare_purple_light</item>
        <item name="colorSecondaryVariant">@color/mothercare_purple</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface_bg</item>
        <!-- Status bar colour matches app background -->
        <item name="android:statusBarColor">#FAF6FC</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorControlActivated">@color/mothercare_purple</item>
        <item name="colorControlHighlight">@color/button_ripple</item>
    </style>
</resources>